@article{EBRAHIMIWARKIANI2025129372,
title = {A comprehensive survey on recent feature selection methods for mixed data: Challenges, solutions and future directions},
journal = {Neurocomputing},
volume = {623},
pages = {129372},
year = {2025},
issn = {0925-2312},
doi = {https://doi.org/10.1016/j.neucom.2025.129372},
url = {https://www.sciencedirect.com/science/article/pii/S092523122500044X},
author = {Mahshid {Ebrahimi Warkiani} and Mohammad Hossein Moattar},
keywords = {Mixed data classification, Feature selection, Wrapper feature selection, Filter feature selection, Meta-heuristic algorithms},
abstract = {Feature selection plays a crucial role in data analysis, pattern recognition, and machine learning by reducing feature dimensions, improving execution time, and enhancing model accuracy. It helps prevent overfitting by removing irrelevant and redundant features, ultimately leading to better model performance. The demand for robust feature selection methods tailored to mixed data has grown due to the increasing focus on multi-modal decision-making and classification in areas such as healthcare, finance, and social media analysis. Selecting features for mixed data presents unique challenges, including correlation assessment, model compatibility, and interpretability, requiring different approaches compared to homogeneous data. This comprehensive review delves into feature selection methodologies specifically designed for mixed data, offering insights into the suitability and effectiveness of various techniques. The surveyed methods cover both supervised and unsupervised approaches, addressing the considerations, challenges, and potential pitfalls inherent in feature selection for mixed data. Additionally, the review introduces benchmark datasets and evaluation metrics crucial for assessing these methods, concluding with a detailed comparison of recent approaches, highlighting their contributions, strengths, and weaknesses. Finally, the review sheds light on future trends and research directions in the field, providing a roadmap for continued advancements in feature selection for mixed data.}
}

